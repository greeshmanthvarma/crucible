    "tools": [
      {
        "name": "list_files",
        "description": "List stable workspace-relative file paths.",
        "input_schema": {
          "additionalProperties": false,
          "properties": {
            "path": {
              "default": ".",
              "title": "Path",
              "type": "string"
            }
          },
          "title": "ListFilesArguments",
          "type": "object"
        },
        "schema_version": 1
      },
      {
        "name": "search_files",
        "description": "Search workspace text with a ripgrep regular expression. Returns bounded matching excerpts with workspace-relative paths, line numbers and UTF-8 byte offsets, including on long lines. Pass next_cursor unchanged with the same query and path to continue when truncated. No matches is conclusive only when truncated is false and there is no error. A snippet may omit part of a large match; use its offsets for bounded reads. Search is not a snapshot: restart without a cursor if files change.",
        "input_schema": {
          "$defs": {
            "SearchCursor": {
              "additionalProperties": false,
              "properties": {
                "path": {
                  "maxLength": 4096,
                  "minLength": 1,
                  "title": "Path",
                  "type": "string"
                },
                "byte_offset": {
                  "minimum": 1,
                  "title": "Byte Offset",
                  "type": "integer"
                },
                "query_digest": {
                  "pattern": "^[0-9a-f]{64}$",
                  "title": "Query Digest",
                  "type": "string"
                }
              },
              "required": [
                "path",
                "byte_offset",
                "query_digest"
              ],
              "title": "SearchCursor",
              "type": "object"
            }
          },
          "additionalProperties": false,
          "properties": {
            "query": {
              "maxLength": 500,
              "minLength": 1,
              "title": "Query",
              "type": "string"
            },
            "path": {
              "default": ".",
              "title": "Path",
              "type": "string"
            },
            "cursor": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SearchCursor"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            }
          },
          "required": [
            "query"
          ],
          "title": "SearchFilesArguments",
          "type": "object"
        },
        "schema_version": 1
      },
      {
        "name": "read_file",
        "description": "Read a bounded UTF-8 workspace file range.",
        "input_schema": {
          "additionalProperties": false,
          "properties": {
            "path": {
              "title": "Path",
              "type": "string"
            },
            "start_line": {
              "default": 1,
              "minimum": 1,
              "title": "Start Line",
              "type": "integer"
            },
            "end_line": {
              "anyOf": [
                {
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "End Line"
            }
          },
          "required": [
            "path"
          ],
          "title": "ReadFileArguments",
          "type": "object"
        },
        "schema_version": 1
      },
      {
        "name": "workspace_status",
        "description": "Inspect Git workspace status.",
        "input_schema": {
          "additionalProperties": false,
          "properties": {},
          "title": "WorkspaceStatusArguments",
          "type": "object"
        },
        "schema_version": 1
      },
      {
        "name": "workspace_diff",
        "description": "Inspect the current Git workspace diff.",
        "input_schema": {
          "additionalProperties": false,
          "properties": {},
          "title": "WorkspaceDiffArguments",
          "type": "object"
        },
        "schema_version": 1
      },
      {
        "name": "apply_patch",
        "description": "Apply a standard unified diff inside the workspace. Include --- a/path, +++ b/path, and numbered @@ -old +new @@ hunk headers. The *** Begin Patch / *** Update File format is not supported.",
        "input_schema": {
          "additionalProperties": false,
          "properties": {
            "patch": {
              "maxLength": 1000000,
              "minLength": 1,
              "title": "Patch",
              "type": "string"
            }
          },
          "required": [
            "patch"
          ],
          "title": "ApplyPatchArguments",
          "type": "object"
        },
        "schema_version": 1
      },
      {
