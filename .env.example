# Copy to .env and fill in your own API key. The backend loads this file with
# `uv run --env-file ../.env ...` when started from backend/.
OPENAI_API_KEY=

# Paths are relative to backend/ when the server is started there.
CRUCIBLE_DATABASE_URL=sqlite+aiosqlite:///crucible.db
CRUCIBLE_DATA_DIR=data

# Match the exact URL used to open the Vite frontend (localhost != 127.0.0.1).
CRUCIBLE_DEVELOPMENT_ORIGIN=http://localhost:5173
